{
  // Mirrors the app's compiler settings (tsconfig.json) so the specs type-check
  // the same way the code they drive does — the specs reach into app modules
  // for types (see global.d.ts), which needs matching jsx/module resolution.
  // `vite/client` supplies import.meta.env; `node` covers the Playwright side.
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "vite/client"]
  },
  "include": ["."]
}
