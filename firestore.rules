rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Visibility: 'private' (owner only) / 'unlisted' (anyone with the link) /
    // 'public' (listed in the gallery). Legacy docs carry only the `private`
    // boolean and map to private/unlisted.
    function vis(data) {
      return data.get('visibility', data.get('private', false) == true ? 'private' : 'unlisted');
    }

    // Gallery-facing fields are denormalized and client-written. Bound their
    // size and shape so a public card can't carry a multi-KB payload (every
    // gallery visitor downloads it) or a non-https `authorPhoto` beacon. null
    // is allowed (the author stamp writes null when the profile lacks a value).
    // NOTE: author *identity* is still self-asserted — an owner can put any
    // name on their own card. True anti-impersonation needs server-side
    // stamping (a Cloud Function), tracked separately; this only limits blast radius.
    function strWithin(v, max) {
      return v == null || (v is string && v.size() <= max);
    }
    function photoValid(v) {
      return v == null || v == '' || (v is string && v.size() <= 512 && v.matches('https://.*'));
    }
    function galleryFieldsValid(d) {
      return strWithin(d.get('title', null), 200)
             && strWithin(d.get('description', null), 500)
             && strWithin(d.get('authorName', null), 120)
             && photoValid(d.get('authorPhoto', null));
    }

    // SVG files — readable by anyone unless private, only owner can write
    match /files/{fileId} {
      // resource is null when the doc doesn't exist yet (e.g. ensureFileDoc's
      // existence check, or opening an unknown id) — allow that read so it
      // resolves to "not found" instead of erroring on null.data.
      allow read: if resource == null
                  || vis(resource.data) != 'private'
                  || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && galleryFieldsValid(request.resource.data);
      allow update: if request.auth != null
                    && (resource.data.uid == null
                        || resource.data.uid == request.auth.uid)
                    && galleryFieldsValid(request.resource.data);
      // Allow any authenticated user to increment view/download counters by 1
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'downloads'])
                    && (request.resource.data.get('views', resource.data.get('views', 0)) == resource.data.get('views', 0)
                        || request.resource.data.views == resource.data.get('views', 0) + 1)
                    && (request.resource.data.get('downloads', resource.data.get('downloads', 0)) == resource.data.get('downloads', 0)
                        || request.resource.data.downloads == resource.data.get('downloads', 0) + 1);
      allow delete: if request.auth != null
                    && (resource.data.uid == null
                        || resource.data.uid == request.auth.uid);

      // AI chat for this document — present only when AI was used. Read mirrors
      // the document's privacy (so public chats show in the gallery); only the
      // owner writes, and chat requires a real (non-anonymous) account.
      match /messages/{messageId} {
        // A fresh document may have no files/{id} doc yet — get() would return
        // null and error. Treat "no parent doc" as an empty, readable chat.
        allow read: if !exists(/databases/$(database)/documents/files/$(fileId))
                    || vis(get(/databases/$(database)/documents/files/$(fileId)).data) != 'private'
                    || (request.auth != null
                        && get(/databases/$(database)/documents/files/$(fileId)).data.uid == request.auth.uid);
        allow write: if request.auth != null
                     && request.auth.token.firebase.sign_in_provider != 'anonymous'
                     && get(/databases/$(database)/documents/files/$(fileId)).data.uid == request.auth.uid;
      }
    }

    // User profile / subscription tier — owner read-only, server writes via Admin SDK
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
    match /users/{userId}/{document=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
