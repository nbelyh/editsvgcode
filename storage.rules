rules_version = '2';

// Per-user blob space for generated PNGs (SVG stays inline in Firestore).
// Writes are owner-only via the uid in the PATH — deliberately no cross-service
// firestore.get(), which the Storage emulator does not support. Reads require a
// session; paths are content-addressed (sha256) and only discoverable through
// access-controlled Firestore docs, so privacy follows the Firestore layer.
service firebase.storage {
  match /b/{bucket}/o {

    match /blobs/{uid}/{name} {
      allow read: if request.auth != null;
      // create OR update: paths are content-addressed (sha256), so overwriting
      // with the same bytes is harmless — and it lets the client upload
      // unconditionally, with no (404-noisy) existence check first.
      allow create, update: if request.auth != null
                    && request.auth.uid == uid
                    && request.auth.token.firebase.sign_in_provider != 'anonymous'
                    && request.resource.size < 8 * 1024 * 1024
                    && request.resource.contentType == 'image/png';
      allow delete: if false;
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
